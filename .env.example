# ParkEasy client environment
# Copy to .env and adjust. `.env` is gitignored; never commit real values.

# Base URL for the FastAPI backend.
#
# Leave EMPTY to use the dev proxy in vite.config.ts, which forwards /api and
# /ws to http://127.0.0.1:9999. This keeps requests same-origin and avoids CORS.
#
# Set an absolute URL to bypass the proxy (e.g. when the backend is deployed
# separately, or when calling it from a mobile build):
# VITE_API_URL=http://127.0.0.1:9999
VITE_API_URL=
